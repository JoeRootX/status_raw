# GitHub
GITHUB_TOKEN=
GITHUB_EXCLUIR=status_raw
GITHUB_DUENIO=JoeRootX

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# YouTube
# RSS keyless (canal o playlist "lo que comparto"); la Data API solo respaldo.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Playlist pública con lo que comparto: el primero de su feed es el más nuevo.
#YOUTUBE_PLAYLIST_ID=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# JQL opcional (si se omiten se usa assignee = currentUser())
# JIRA_JQL_ACTUAL=
# JIRA_JQL_COLA=

# Telegram (bot de @BotFather; el chat puede ser el propio bot o un id tipo -100...)
# Sin ellas el formulario funciona en modo simulado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secreto del webhook (setWebhook lo valida como header x-telegram-bot-api-secret-token).
# Solo [A-Za-z0-9_-]: openssl rand -hex lo cumple. Regenerarlo = nueva env + redeploy + setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Rutina del horario laboral (/api/rutina, golpeada por un cron externo).
# Secreto compartido con el cron: Authorization: Bearer <valor>. openssl rand -hex 32.
RUTINA_SECRETO=
# (El schedule en QStash apunta a https://<dominio>/api/rutina con ese header:
#  cron UTC "0 15,17,19,21,23,1,3 * * *" = 9,11,13,15,17,19,21 de Jalisco.)
